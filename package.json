{
  "name": "palco",
  "desktopName": "palco",
  "version": "0.1.1",
  "private": true,
  "description": "Ambiente visual para organizar terminais, agentes de IA e projetos em um canvas.",
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "palco": "bin/palco"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:cli",
    "build:cli": "esbuild src/cli/palco.ts --bundle --platform=node --format=cjs --target=node22 --outfile=out/cli/palco.cjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "notices": "node scripts/third-party-notices.mjs",
    "postinstall": "cd node_modules/node-pty && npx -y node-gyp rebuild >/dev/null",
    "icons": "node scripts/build-icons.mjs",
    "install:desktop": "node scripts/install-desktop.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:arch": "npm run dist:linux && bash scripts/dist-arch.sh",
    "dist:flatpak": "npm run build && electron-builder --linux dir --publish never -c.npmRebuild=false -c.electronDist=node_modules/electron/dist -c.extraMetadata.desktopName=io.github.NatanVP.palco.desktop && bash scripts/dist-flatpak.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "jotai": "^3.0.2",
    "katex": "0.18.10",
    "lucide-react": "^1.79.0",
    "mermaid": "11.17.2",
    "motion": "^14.14.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "license": "MIT",
  "author": "NatanVP",
  "keywords": [
    "palco",
    "electron",
    "terminal",
    "ai-agents",
    "canvas",
    "linux",
    "developer-tools"
  ],
  "engines": {
    "node": ">= 22.12.0"
  },
  "homepage": "https://github.com/NatanVP/palco",
  "overrides": {
    "katex": "$katex",
    "minimatch@>=7 <11": "11.0.9"
  }
}
